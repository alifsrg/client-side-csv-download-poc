# Simulated network delay for the ID endpoint (ms)
VITE_MOCK_ID_DELAY_MS=1

# Number of IDs fetched per call to the ID endpoint
VITE_MOCK_ID_BATCH_SIZE=50

# Simulated network delay for the Detail endpoint (ms)
VITE_MOCK_DETAIL_DELAY_MS=1

# Total employee records per company in the mock dataset
VITE_MOCK_TOTAL_RECORDS=2000000

# Number of records that trigger a new CSV part to be finalized and stored
# Production value: 100000. Use a small value here to test part-splitting quickly.
VITE_PART_THRESHOLD=100000

# Number of records between IndexedDB checkpoints (cursor + pending buffer save)
# Production value: 1000. Use a small value here to test crash recovery.
VITE_CHECKPOINT_INTERVAL=10
